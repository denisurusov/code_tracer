{
  "openapi": "3.1.0",
  "info": { "title": "FX Quote demo API", "version": "1.0.0" },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": { "description": "Service is up", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } }
        }
      }
    },
    "/api/pairs": {
      "get": {
        "operationId": "listPairs",
        "responses": {
          "200": { "description": "Supported currency pairs", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Pairs" } } } }
        }
      }
    },
    "/api/quote": {
      "get": {
        "operationId": "getQuote",
        "parameters": [
          { "name": "pair", "in": "query", "required": true, "schema": { "type": "string", "pattern": "^[A-Z]{6}$" } },
          { "name": "amount", "in": "query", "required": true, "schema": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000000 } },
          { "name": "side", "in": "query", "required": true, "schema": { "type": "string", "enum": ["buy", "sell"] } }
        ],
        "responses": {
          "200": { "description": "A quote", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Quote" } } } },
          "400": { "description": "Invalid request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "Unknown pair", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object", "additionalProperties": false, "required": ["status", "pairs"],
        "properties": { "status": { "const": "ok" }, "pairs": { "type": "integer", "minimum": 1 } }
      },
      "Pairs": {
        "type": "array", "minItems": 1,
        "items": { "type": "string", "pattern": "^[A-Z]{6}$" }
      },
      "Quote": {
        "type": "object", "additionalProperties": false,
        "required": ["pair", "side", "amount", "mid", "spreadBps", "price", "converted", "rateAsOf", "quotedAt"],
        "properties": {
          "pair": { "type": "string", "pattern": "^[A-Z]{6}$" },
          "side": { "enum": ["buy", "sell"] },
          "amount": { "type": "number", "exclusiveMinimum": 0 },
          "mid": { "type": "number", "exclusiveMinimum": 0 },
          "spreadBps": { "type": "number", "minimum": 0 },
          "price": { "type": "number", "exclusiveMinimum": 0 },
          "converted": { "type": "number", "exclusiveMinimum": 0 },
          "rateAsOf": { "type": "string", "format": "date-time" },
          "quotedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Error": {
        "type": "object", "additionalProperties": false, "required": ["error"],
        "properties": { "error": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
